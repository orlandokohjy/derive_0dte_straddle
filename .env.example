# ── Derive Credentials ──
# DERIVE_WALLET = your LightAccount (smart-contract wallet) address from
#   app.derive.xyz/developers — NOT your MetaMask/EOA login address.
# DERIVE_SESSION_KEY = private key of an EOA REGISTERED as a session key on the
#   Developers page (with Account/Admin perms + future expiry). Unregistered or
#   expired keys, or using the EOA here instead of the LightAccount above, 403.
DERIVE_ENV=PROD              # PROD or TEST
DERIVE_WALLET=0xYourLightAccountAddress
DERIVE_SESSION_KEY=0xYourRegisteredSessionKeyPrivateKey
DERIVE_SUBACCOUNT_ID=12345

# ── Strategy ──
DRY_RUN=false
QTY_PER_LEG=1.0
INITIAL_CAPITAL_USD=8000

# ── Chase / fill knobs (Derive 0DTE books are thin) ──
# Buy cap / sell floor as a multiple of mark. Raised to 3.0 so the chase can
# walk almost to the ask on a wide book (still post-only — never crosses).
OPTION_CHASE_MAX_SLIPPAGE_FACTOR=3.0
# Must stay ≥ OPTION_CHASE_MAX_SLIPPAGE_FACTOR − 1, else the startup self-test
# locks entries the moment the chase is allowed to reach its own slip cap.
CHASE_SELFTEST_MAX_OVER_MARK=2.05
# Spread gate (fraction of mid). 3.0 = 300 %. Legs with no bid/ask are still
# refused by the two-sided-quote gate regardless of this.
OPTION_MAX_ENTRY_SPREAD_PCT=3.0
OPTION_CHASE_DEADLINE_MIN=20.0

# ── Telegram (Ops Bot — personal chat) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram (Report Bot — group chat) ──
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=

# ── Self-healing entry lock ──
# On (default): an orphan/position lock ("exchange not flat", post-close
# residual, startup reconcile mismatch) re-verifies the exchange at the next
# entry and releases itself if genuinely flat — e.g. a no-bid leg settling at
# expiry. Restarting CANNOT clear these on its own, because the startup
# reconcile re-locks while the residual exists. Kill-switch locks
# (config/self-test/API/stale-state/circuit-breaker) still need an operator.
SELF_HEAL_LOCK_ON_FLAT=true

# ── Post-close re-flatten ──
# Soft budget for the first alert / forcing taker. With PERSIST=true (default)
# the algo keeps closing residual legs until the exchange is flat — no
# orphan lock and no manual force_liquidate.
CLOSE_FLATTEN_BUDGET_MIN=10
CLOSE_FLATTEN_ROUND_MIN=1
CLOSE_FLATTEN_PERSIST=true
CLOSE_FLATTEN_TAKER_AFTER_ROUNDS=2

# ── Logging ──
LOG_LEVEL=INFO
